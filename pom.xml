<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Maven Project Dashboard - Figma Design</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            background: #f0f2f5;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 40px 20px;
        }

        /* Main Dashboard Container */
        .dashboard {
            max-width: 1200px;
            width: 100%;
            background: #ffffff;
            border-radius: 32px;
            padding: 40px;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.08), 0 8px 20px rgba(0, 0, 0, 0.04);
            animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
            opacity: 0;
            transform: translateY(20px);
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        /* Header */
        .header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 36px;
            flex-wrap: wrap;
            gap: 16px;
        }

        .header-left {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .header-left h1 {
            font-size: 28px;
            font-weight: 700;
            color: #0a0a0a;
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .badge {
            font-size: 13px;
            font-weight: 600;
            padding: 4px 14px;
            border-radius: 100px;
            background: #eef2ff;
            color: #4f46e5;
        }

        .header-left .subtitle {
            color: #6b7280;
            font-size: 15px;
            font-weight: 400;
        }

        .header-right {
            display: flex;
            align-items: center;
            gap: 12px;
            background: #f9fafb;
            padding: 8px 16px 8px 20px;
            border-radius: 100px;
            border: 1px solid #e5e7eb;
            animation: pulseGlow 3s infinite alternate;
        }

        @keyframes pulseGlow {
            0% { border-color: #e5e7eb; box-shadow: 0 0 0 0 rgba(79, 70, 229, 0); }
            100% { border-color: #4f46e5; box-shadow: 0 0 20px rgba(79, 70, 229, 0.10); }
        }

        .status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: #22c55e;
            animation: blink 1.8s ease-in-out infinite;
        }

        @keyframes blink {
            0%, 100% { opacity: 1; transform: scale(1); }
            50% { opacity: 0.3; transform: scale(0.8); }
        }

        .header-right span {
            font-size: 14px;
            font-weight: 500;
            color: #1f2937;
        }

        /* Stats Grid */
        .stats-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 16px;
            margin-bottom: 32px;
        }

        .stat-card {
            background: #f9fafb;
            padding: 20px 24px;
            border-radius: 18px;
            border: 1px solid #f3f4f6;
            transition: all 0.25s ease;
            cursor: default;
            animation: floatIn 0.6s ease backwards;
        }

        .stat-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.04);
            border-color: #d1d5db;
        }

        .stat-card:nth-child(1) { animation-delay: 0.05s; }
        .stat-card:nth-child(2) { animation-delay: 0.10s; }
        .stat-card:nth-child(3) { animation-delay: 0.15s; }
        .stat-card:nth-child(4) { animation-delay: 0.20s; }

        @keyframes floatIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .stat-label {
            font-size: 13px;
            font-weight: 500;
            color: #6b7280;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

        .stat-value {
            font-size: 28px;
            font-weight: 700;
            color: #0a0a0a;
            margin-top: 4px;
            letter-spacing: -0.3px;
        }

        .stat-value small {
            font-size: 16px;
            font-weight: 400;
            color: #6b7280;
            margin-left: 6px;
        }

        /* Project Structure */
        .section-title {
            font-size: 18px;
            font-weight: 600;
            color: #0a0a0a;
            margin-bottom: 18px;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .section-title .count {
            background: #e5e7eb;
            color: #374151;
            font-size: 13px;
            font-weight: 500;
            padding: 0 12px;
            border-radius: 100px;
            line-height: 26px;
        }

        .tree {
            background: #f9fafb;
            border-radius: 20px;
            padding: 20px 24px;
            border: 1px solid #f3f4f6;
            margin-bottom: 32px;
            transition: all 0.3s ease;
        }

        .tree:hover {
            border-color: #d1d5db;
        }

        .tree-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 8px 0;
            font-size: 14px;
            color: #1f2937;
            border-bottom: 1px solid transparent;
            transition: all 0.2s ease;
            cursor: default;
            position: relative;
        }

        .tree-item:hover {
            background: #ffffff;
            padding-left: 12px;
            border-radius: 10px;
            border-bottom-color: #e5e7eb;
        }

        .tree-item .icon {
            width: 28px;
            height: 28px;
            border-radius: 8px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 600;
            flex-shrink: 0;
            background: #eef2ff;
            color: #4f46e5;
            transition: transform 0.2s ease;
        }

        .tree-item:hover .icon {
            transform: scale(1.08);
        }

        .tree-item .key {
            font-weight: 500;
            color: #111827;
            min-width: 180px;
        }

        .tree-item .value {
            color: #6b7280;
            word-break: break-all;
        }

        .tree-item .arrow {
            margin-left: auto;
            color: #9ca3af;
            font-size: 12px;
            transition: transform 0.2s ease;
        }

        .tree-item:hover .arrow {
            transform: translateX(4px);
            color: #4f46e5;
        }

        /* Dependencies */
        .deps-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
            gap: 12px;
            margin-bottom: 32px;
        }

        .dep-chip {
            background: #f9fafb;
            padding: 14px 20px;
            border-radius: 14px;
            border: 1px solid #f3f4f6;
            display: flex;
            align-items: center;
            gap: 14px;
            transition: all 0.2s ease;
            cursor: default;
            animation: fadeInUp 0.5s ease backwards;
        }

        .dep-chip:nth-child(1) { animation-delay: 0.05s; }
        .dep-chip:nth-child(2) { animation-delay: 0.10s; }
        .dep-chip:nth-child(3) { animation-delay: 0.15s; }

        .dep-chip:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.03);
            border-color: #d1d5db;
        }

        .dep-chip .dep-icon {
            width: 36px;
            height: 36px;
            border-radius: 10px;
            background: #eef2ff;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 600;
            font-size: 12px;
            color: #4f46e5;
        }

        .dep-chip .dep-info {
            display: flex;
            flex-direction: column;
        }

        .dep-chip .dep-name {
            font-weight: 500;
            color: #111827;
            font-size: 14px;
        }

        .dep-chip .dep-version {
            font-size: 12px;
            color: #6b7280;
        }

        .dep-chip .dep-scope {
            margin-left: auto;
            font-size: 11px;
            font-weight: 500;
            padding: 2px 12px;
            border-radius: 100px;
            background: #e5e7eb;
            color: #374151;
        }

        /* Repository & Build */
        .bottom-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-top: 8px;
        }

        @media (max-width: 768px) {
            .bottom-grid {
                grid-template-columns: 1fr;
            }
        }

        .card {
            background: #f9fafb;
            border-radius: 20px;
            padding: 20px 24px;
            border: 1px solid #f3f4f6;
            transition: all 0.25s ease;
        }

        .card:hover {
            border-color: #d1d5db;
        }

        .card-title {
            font-size: 14px;
            font-weight: 600;
            color: #0a0a0a;
            margin-bottom: 14px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .card-title .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: #4f46e5;
        }

        .repo-line {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 8px 0;
            font-size: 13px;
            color: #1f2937;
            border-bottom: 1px solid #f3f4f6;
            transition: all 0.15s ease;
        }

        .repo-line:last-child {
            border-bottom: none;
        }

        .repo-line .label {
            font-weight: 500;
            color: #6b7280;
            min-width: 100px;
        }

        .repo-line .value {
            color: #111827;
            word-break: break-all;
        }

        .repo-line .copy {
            margin-left: auto;
            color: #9ca3af;
            font-size: 12px;
            cursor: default;
            transition: color 0.2s ease;
        }

        .repo-line:hover .copy {
            color: #4f46e5;
        }

        /* Animated floating decoration */
        .float-deco {
            position: fixed;
            width: 300px;
            height: 300px;
            background: radial-gradient(circle at 30% 30%, rgba(79, 70, 229, 0.04), transparent 70%);
            border-radius: 50%;
            top: -100px;
            right: -100px;
            z-index: -1;
            animation: floatBlob 20s ease-in-out infinite alternate;
        }

        .float-deco-2 {
            position: fixed;
            width: 400px;
            height: 400px;
            background: radial-gradient(circle at 70% 70%, rgba(79, 70, 229, 0.03), transparent 70%);
            border-radius: 50%;
            bottom: -150px;
            left: -150px;
            z-index: -1;
            animation: floatBlob 25s ease-in-out infinite alternate-reverse;
        }

        @keyframes floatBlob {
            0% { transform: translate(0, 0) scale(1); }
            100% { transform: translate(40px, 20px) scale(1.1); }
        }

        /* Responsive */
        @media (max-width: 600px) {
            .dashboard {
                padding: 24px 16px;
                border-radius: 20px;
            }
            .header-left h1 {
                font-size: 22px;
            }
            .stat-value {
                font-size: 22px;
            }
            .tree-item {
                flex-wrap: wrap;
            }
            .tree-item .key {
                min-width: 100px;
            }
        }
    </style>
</head>
<body>
    <!-- Background decorations -->
    <div class="float-deco"></div>
    <div class="float-deco-2"></div>

    <div class="dashboard">
        <!-- Header -->
        <div class="header">
            <div class="header-left">
                <h1>
                    📦 myweb
                    <span class="badge">v8.8.5</span>
                </h1>
                <div class="subtitle">in.javahome · WAR packaging · Java 8</div>
            </div>
            <div class="header-right">
                <div class="status-dot"></div>
                <span>Build Ready</span>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-label">Dependencies</div>
                <div class="stat-value">1 <small>+ dev</small></div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Plugins</div>
                <div class="stat-value">4</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Repositories</div>
                <div class="stat-value">2</div>
            </div>
            <div class="stat-card">
                <div class="stat-label">Java Release</div>
                <div class="stat-value">8</div>
            </div>
        </div>

        <!-- Project Tree (POM structure) -->
        <div class="section-title">
            📄 Project Structure
            <span class="count">POM</span>
        </div>
        <div class="tree">
            <div class="tree-item">
                <div class="icon">G</div>
                <span class="key">groupId</span>
                <span class="value">in.javahome</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">A</div>
                <span class="key">artifactId</span>
                <span class="value">myweb</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">V</div>
                <span class="key">version</span>
                <span class="value">8.8.5</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">📦</div>
                <span class="key">packaging</span>
                <span class="value">war</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">☕</div>
                <span class="key">maven.compiler.release</span>
                <span class="value">8</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">🐳</div>
                <span class="key">docker.image.prefix</span>
                <span class="value">kammana</span>
                <span class="arrow">→</span>
            </div>
            <div class="tree-item">
                <div class="icon">📡</div>
                <span class="key">sonar.host.url</span>
                <span class="value">18.181.164.81:9000</span>
                <span class="arrow">→</span>
            </div>
        </div>

        <!-- Dependencies -->
        <div class="section-title">
            📚 Dependencies
            <span class="count">1</span>
        </div>
        <div class="deps-grid">
            <div class="dep-chip">
                <div class="dep-icon">J</div>
                <div class="dep-info">
                    <span class="dep-name">junit</span>
                    <span class="dep-version">4.13.2</span>
                </div>
                <span class="dep-scope">test</span>
            </div>
            <!-- you could add more here if needed -->
        </div>

        <!-- Bottom: Repositories + Build -->
        <div class="bottom-grid">
            <!-- Repositories -->
            <div class="card">
                <div class="card-title">
                    <span class="dot"></span> Repositories
                </div>
                <div class="repo-line">
                    <span class="label">flm-feed</span>
                    <span class="value">Azure DevOps</span>
                    <span class="copy">↗</span>
                </div>
                <div class="repo-line">
                    <span class="label">nexusRepo</span>
                    <span class="value">snapshots</span>
                    <span class="copy">↗</span>
                </div>
                <div style="margin-top: 12px; font-size: 13px; color: #6b7280; background: #f3f4f6; padding: 8px 14px; border-radius: 10px;">
                    <span style="font-weight:500;">flm-feed</span> 
                    <span style="color:#4f46e5;">pkgs.dev.azure.com/...</span>
                </div>
            </div>

            <!-- Build / Plugins -->
            <div class="card">
                <div class="card-title">
                    <span class="dot"></span> Build &amp; Plugins
                </div>
                <div class="repo-line">
                    <span class="label">finalName</span>
                    <span class="value">myweb</span>
                </div>
                <div class="repo-line">
                    <span class="label">maven-resources</span>
                    <span class="value">3.3.1</span>
                </div>
                <div class="repo-line">
                    <span class="label">maven-compiler</span>
                    <span class="value">3.13.0 (release 8)</span>
                </div>
                <div class="repo-line">
                    <span class="label">maven-surefire</span>
                    <span class="value">3.2.5</span>
                </div>
                <div class="repo-line">
                    <span class="label">maven-war</span>
                    <span class="value">3.4.0</span>
                </div>
            </div>
        </div>

        <!-- subtle footer -->
        <div style="margin-top: 28px; text-align: right; font-size: 12px; color: #9ca3af; border-top: 1px solid #f3f4f6; padding-top: 18px;">
            <span>Maven 4.0.0 · </span>
            <span style="background: #f3f4f6; padding: 2px 12px; border-radius: 100px;">Java Home myweb</span>
            <span style="margin-left: 8px;">⚡ animated dashboard</span>
        </div>
    </div>

    <!-- Additional micro-interactions (JS) -->
    <script>
        // Add a tiny interactive hover effect on stat cards
        document.querySelectorAll('.stat-card, .dep-chip, .tree-item, .card').forEach(el => {
            el.addEventListener('mouseenter', function() {
                this.style.transition = 'all 0.15s ease';
            });
        });

        // Simulate a "live" timestamp update
        const statusDot = document.querySelector('.status-dot');
        const statusText = document.querySelector('.header-right span');
        if (statusText) {
            setInterval(() => {
                const now = new Date();
                const time = now.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit' });
                statusText.textContent = `Live · ${time}`;
            }, 1000);
        }

        console.log('🎨 Figma-style dashboard with animations loaded.');
        console.log('📦 Maven project: in.javahome:myweb:8.8.5');
    </script>

</body>
</html>
